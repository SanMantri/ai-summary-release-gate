{
  "name": "ai-summary-release-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright release gate for an AI-assisted support-ticket summary feature",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/dashboard-ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:static": "npm run typecheck && npm run lint && npm run format:check",
    "test:unit": "vitest run",
    "start:server": "tsx src/server/start-dashboard-server.ts",
    "start": "npm run build:ui && npm run start:server",
    "dev": "concurrently --names api,ui --prefix-colors blue,magenta \"tsx watch src/server/start-dashboard-server.ts\" \"vite\"",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-chromium",
    "test:smoke": "playwright test --project=smoke-chromium",
    "test:eval": "RELEASE_GATE_LAYER=eval playwright test --project=eval",
    "test:gate": "npm run check:static && npm run test:unit && playwright test",
    "test:advisory": "RELEASE_GATE_ADVISORY=1 playwright test --project=ui-firefox --project=ui-webkit --project=quarantined --pass-with-no-tests",
    "report": "playwright show-report"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
